{
  "name": "@overtchat/connector",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "bin": {
    "overtchat-connector": "./dist/overtchat-connector.mjs"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node22 --format=esm --external:node-pty --external:node-pty/* --banner:js=\"import { createRequire as __overtchatCreateRequire } from 'node:module'; const require = __overtchatCreateRequire(import.meta.url);\" --outfile=dist/overtchat-connector.mjs",
    "build:package": "node scripts/package.mjs",
    "lint": "eslint src scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:journal-scale": "node --expose-gc --max-old-space-size=256 --import tsx scripts/journal-scale.mjs"
  },
  "dependencies": {
    "@overtchat/agent-bridge": "*",
    "@overtchat/agent-runtime": "*",
    "@streamparser/json": "^0.0.26",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "node-pty": "1.2.0-beta.15",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4.1.11"
  }
}
