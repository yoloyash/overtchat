{
  "name": "@overtchat/connector",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "bin": {
    "overtchat-connector": "./dist/overtchat-connector.mjs"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/overtchat-connector.mjs",
    "build:binary": "bun build src/cli.ts --compile --outfile dist/overtchat-connector",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:journal-scale": "node --expose-gc --max-old-space-size=256 --import tsx scripts/journal-scale.mjs"
  },
  "dependencies": {
    "@overtchat/agent-bridge": "*",
    "@overtchat/agent-runtime": "*",
    "@streamparser/json": "^0.0.26"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4.1.11"
  }
}
