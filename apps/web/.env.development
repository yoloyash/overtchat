# Safe source-development defaults. Machine-specific overrides belong in
# .env.local, which Next.js loads before this file.
BETTER_AUTH_URL=http://localhost:4717
HOST_CONNECTOR_URL=http://127.0.0.1:4717
# The full root runner supplies a local URL. A workspace-only Next.js process
# deliberately overrides any container-only REDIS_URL inherited from .env.
REDIS_URL=
