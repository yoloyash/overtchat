{
  "name": "@overtchat/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "mkdir -p data && next dev -p 4717",
    "build": "next build",
    "start": "mkdir -p data && next start -p 4717",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "rm -f data/test.db* && playwright test",
    "test:e2e:ui": "rm -f data/test.db* && playwright test --ui",
    "auth:generate": "npx --yes auth@1.6.11 generate --config lib/auth/server.ts --output lib/db/schema.ts --y",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "mkdir -p data && drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.21",
    "@ai-sdk/google": "^4.0.24",
    "@ai-sdk/open-responses": "^2.0.12",
    "@ai-sdk/openai": "^4.0.20",
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@ai-sdk/react": "^4.0.40",
    "@base-ui/react": "^1.6.0",
    "@better-auth/expo": "1.6.23",
    "@overtchat/shared": "*",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "ai": "^7.0.37",
    "better-auth": "1.6.23",
    "better-sqlite3": "^13.0.1",
    "class-variance-authority": "^0.7.1",
    "clipboard-polyfill": "^4.1.1",
    "clsx": "^2.1.1",
    "defuddle": "^0.19.2",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.2",
    "ipaddr.js": "^2.4.0",
    "katex": "^0.18.1",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.27.0",
    "mammoth": "^1.12.0",
    "media-chrome": "^4.19.2",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-simple-code-editor": "^0.14.1",
    "redis": "^6.1.0",
    "remark": "^15.0.1",
    "remark-breaks": "^4.0.0",
    "resumable-stream": "^2.2.12",
    "server-only": "^0.0.1",
    "shadcn": "^4.15.0",
    "streamdown": "^2.5.0",
    "strip-markdown": "^6.0.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.0",
    "use-stick-to-bottom": "^1.1.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.6",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10",
