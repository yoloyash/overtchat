{
  "name": "@overtchat/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "mkdir -p data && next dev -p ${PORT:-4717}",
    "build": "next build",
    "postbuild": "node scripts/sanitize-build-output.mjs",
    "start": "mkdir -p data && next start -p 4717",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:library": "node --conditions=react-server --import tsx scripts/benchmark-library.ts",
    "test:e2e": "rm -f data/test.db* && playwright test",
    "test:e2e:ui": "rm -f data/test.db* && playwright test --ui",
    "catalog:generate": "tsx scripts/generate-model-catalog.ts",
    "catalog:check": "tsx scripts/check-model-catalog.ts",
    "auth:generate": "npx --yes auth@1.7.10 generate --config lib/auth/server.ts --output lib/db/schema.ts --y",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "mkdir -p data && drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "openui:build": "node scripts/build-openui.mjs",
    "openui:generate": "tsx scripts/generate-openui-spec.ts",
    "openui:check": "tsx scripts/generate-openui-spec.ts --check",
    "prebuild": "npm run openui:build",
    "predev": "npm run openui:build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.16",
    "@ai-sdk/google": "^4.0.18",
    "@ai-sdk/mcp": "^2.0.40",
    "@ai-sdk/open-responses": "^2.0.11",
    "@ai-sdk/openai": "^4.0.16",
    "@ai-sdk/openai-compatible": "^3.0.12",
    "@ai-sdk/react": "^4.0.87",
    "@base-ui/react": "^1.4.1",
    "@better-auth/expo": "1.7.10",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@openai/agents": "0.14.3",
    "@openuidev/lang-core": "1.0.1",
    "@openuidev/react-headless": "0.18.1",
    "@openuidev/react-lang": "1.0.1",
    "@openuidev/react-ui": "0.18.1",
    "@overtchat/agent-bridge": "*",
    "@overtchat/shared": "*",
    "@overtchat/voice-client": "*",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-query-devtools": "^5.100.10",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-virtual": "^3.14.10",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "@yoloyash/web-basics": "0.5.0",
    "ai": "^7.0.84",
    "better-auth": "1.7.10",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clipboard-polyfill": "^4.1.1",
    "clsx": "^2.1.1",
    "devicons-react": "^1.5.0",
    "docx": "^9.14.0",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.2",
    "js-tiktoken": "^1.0.21",
    "katex": "0.18.2",
    "linkedom": "^0.18.12",
    "lucide-react": "^1.14.0",
    "mammoth": "^1.12.0",
    "media-chrome": "^4.19.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-simple-code-editor": "^0.14.1",
    "redis": "^5.12.1",
    "remark": "^15.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "resumable-stream": "^2.2.12",
    "server-only": "^0.0.1",
    "shadcn": "^4.7.0",
    "simple-icons": "^16.29.0",
    "streamdown": "^2.5.0",
    "strip-markdown": "^6.0.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.6.2",
    "use-stick-to-bottom": "^1.1.6",
    "ws": "^8.18.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitest/ui": "4.1.12",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "4.1.12",
    "esbuild": "0.25.12"
  }
}
