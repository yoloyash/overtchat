{
  "name": "overtchat",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev.mjs --web-only",
    "dev:mobile": "npm run dev -w apps/mobile --",
    "dev:site": "npm run dev -w apps/site --",
    "dev:managed": "npm run dev -w apps/cli -- setup --development",
    "dev:down": "docker compose -f compose.dev.yml down",
    "dev:reset-connector": "node scripts/dev.mjs --reset-connector",
    "test:dev": "node --test scripts/dev.test.mjs .github/scripts/*.test.mjs",
    "build": "turbo run build",
    "lint": "npm run lint:dev && turbo run lint",
    "lint:dev": "eslint --config apps/cli/eslint.config.mjs scripts/dev.mjs scripts/dev.test.mjs .github/scripts/assert-image-platforms.mjs .github/scripts/assert-image-platforms.test.mjs .github/scripts/assert-owned-image.mjs .github/scripts/assert-owned-image.test.mjs",
    "typecheck": "turbo run typecheck",
    "test": "npm run test:dev && turbo run test",
    "test:e2e": "npm run test:e2e -w apps/web --",
    "test:e2e:ui": "npm run test:e2e:ui -w apps/web --",
    "start": "npm run start -w apps/web --",
    "deps:check": "node .github/scripts/check-single-instance-deps.mjs",
    "db:generate": "npm run db:generate -w apps/web --",
    "db:migrate": "npm run db:migrate -w apps/web --",
    "db:studio": "npm run db:studio -w apps/web --",
    "catalog:generate": "npm run catalog:generate -w apps/web --",
    "catalog:check": "npm run catalog:check -w apps/web --",
    "auth:generate": "npm run auth:generate -w apps/web --",
    "site:deploy": "npx --yes wrangler@4.114.0 deploy",
    "site:preview": "npx --yes wrangler@4.114.0 versions upload"
  },
  "devDependencies": {
    "turbo": "^2.9.6"
  },
  "dependencies": {
    "expo-crypto": "~56.0.3"
  }
}
