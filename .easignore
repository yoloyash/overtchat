# EAS reads this at the repository root and ignores all .gitignore files.
# Keep the root and mobile exclusions below in sync with their .gitignore files.

# dependencies
node_modules
/.pnp
.pnp.*

# testing
/coverage
test-results/
playwright-report/
blob-report/
playwright/.cache/

# next.js
.next/
/out/
/apps/site/out/

# turborepo
.turbo

# production
/build
/dist
/apps/connector/dist/
/apps/cli/dist/

# data (dev SQLite DB only; anchored so it can't match source dirs like settings/data/)
/apps/web/data/
*.db
*.db-journal
*.db-wal
*.db-shm

# misc
.DS_Store
*.pem
*.log
ROADMAP.md
ROADMAP_MOBILE.md
GEMINI.md
CLAUDE.md
/scripts/*
!/scripts/install-connector.sh
!/scripts/dev.mjs
!/scripts/dev.test.mjs
!/scripts/readme-media.mjs
!/scripts/readme-android.mjs
/.readme-media/
/apps/web/scripts/seed.ts

# generated local-development credentials and Host Connector runtime state
/.overtchat-dev/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env
.env*.local

# Google service account JSON keys (any *.json at repo root looking like a key)
/overtchat-*.json
/*-service-account*.json

# local-only compose overrides (per-developer)
*.local.yml
compose.override.yml
compose.override.yaml

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
__pycache__/
*.pyc

# IDEs
.vscode/
.idea/
*.swp
*.swo

# cache
/vllm-cache

# expo CNG: native dirs are regenerated by `expo prebuild`
apps/mobile/android/
apps/mobile/ios/
apps/mobile/.expo/
apps/mobile/credentials.json
apps/mobile/credentials/

# tools
.gemini
.claude

# apps/mobile/.gitignore (patterns scoped to the mobile workspace)
# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
/apps/mobile/**/node_modules/

# Expo
/apps/mobile/**/.expo/
/apps/mobile/**/dist/
/apps/mobile/**/web-build/
/apps/mobile/**/expo-env.d.ts

# Native
/apps/mobile/**/.kotlin/
/apps/mobile/**/*.orig.*
/apps/mobile/**/*.jks
/apps/mobile/**/*.keystore
/apps/mobile/**/*.p8
/apps/mobile/**/*.p12
/apps/mobile/**/*.key
/apps/mobile/**/*.mobileprovision
/apps/mobile/**/credentials.json
/apps/mobile/**/credentials/

# Metro
/apps/mobile/**/.metro-health-check*

# debug
/apps/mobile/**/npm-debug.*
/apps/mobile/**/yarn-debug.*
/apps/mobile/**/yarn-error.*

# macOS
/apps/mobile/**/.DS_Store
/apps/mobile/**/*.pem

# local env files
/apps/mobile/**/.env*.local

# typescript
/apps/mobile/**/*.tsbuildinfo

/apps/mobile/**/example

# generated native folders
/apps/mobile/ios
/apps/mobile/android

# Local Firebase app configuration (or use GOOGLE_SERVICES_JSON).
/apps/mobile/**/google-services.json

# Firebase client configuration is needed in the isolated native build.
# Keep it gitignored; signing credentials and service account keys stay excluded.
!/apps/mobile/google-services.json
